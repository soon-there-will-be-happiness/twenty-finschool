# Copy to .env and fill secrets. One file per partner instance.
COMPOSE_PROJECT_NAME=twenty-PARTNER_SLUG

FINSCHOOL_TWENTY_IMAGE=finschool/twenty:local
HOST_BIND=127.0.0.1
HOST_PORT=3000
SSO_HOST_PORT=3099

SERVER_URL=https://crm-PARTNER_SLUG.finschool.pro
TAG=local

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=change-me
PG_DATABASE_NAME=default
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432

REDIS_URL=redis://redis:6379
REDIS_CACHE_PREFIX=PARTNER_SLUG

STORAGE_TYPE=local
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

# Required — generate unique per partner
APP_SECRET=
ENCRYPTION_KEY=

# Feature flags (stub — consumed after front wiring)
FINSCHOOL_FEATURE_MESSAGING=false
FINSCHOOL_FEATURE_CALENDAR=false
FINSCHOOL_FEATURE_AI=false
FINSCHOOL_FEATURE_WORKFLOW=true
